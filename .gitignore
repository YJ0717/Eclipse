# Created by https://www.toptal.com/developers/gitignore/api/unrealengine
# Edit at https://www.toptal.com/developers/gitignore?templates=unrealengine

### UnrealEngine ###
# Visual Studio 2015 user specific files
Eclipse/.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
Eclipse/*.xcodeproj
Eclipse/*.xcworkspace
Eclipse/*.sln
Eclipse/*.suo
Eclipse/*.opensdf
Eclipse/*.sdf
Eclipse/*.VC.db
Eclipse/*.VC.opendb

# Precompiled Assets
Eclipse/SourceArt/**/*.png
Eclipse/SourceArt/**/*.tga

# Binary Files
Eclipse/Binaries/

# Builds
Eclipse/Build/

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Eclipse/Build/*/
Eclipse/Build/*/**
!Eclipse/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Eclipse/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Eclipse/Saved/

# Compiled source files for the engine to use
Eclipse/Intermediate/

# Cache files for the editor to use
Eclipse/DerivedDataCache/

### UnrealEngine Patch ###
# Don't ignore icon and splash images for mobile app
!Eclipse/Build/IOS/Resources/
Eclipse/Build/IOS/Resources/*
!Eclipse/Build/IOS/Resources/Graphics/
Eclipse/Build/IOS/Resources/Graphics/*
!Eclipse/Build/IOS/Resources/Graphics/*.png
!Eclipse/Build/Android/res/
Eclipse/Build/Android/res/*
!Eclipse/Build/Android/res/*/
Eclipse/Build/Android/res/*/*
!Eclipse/Build/Android/res/*/*.png
# Ignore plugins binaries on deep subfolders
Eclipse/Plugins/**/Binaries/
Eclipse/Plugins/**/Intermediate/

# End of https://www.toptal.com/developers/gitignore/api/unrealengine
